# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_SONNET_MODEL=claude-sonnet-5

# Firebase Admin / App Hosting
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
# 로컬 스크립트(sync:wiki)에서만 사용. App Hosting은 런타임 서비스 계정을 쓰므로 비워 둡니다.
GOOGLE_APPLICATION_CREDENTIALS=
REQUIRE_APP_CHECK=false

# Firebase Web client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPOSITORY=owner/future-wiki
GITHUB_WEBHOOK_SECRET=
