# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5
ANTHROPIC_SONNET_MODEL=claude-sonnet-5

# Firebase Admin / App Hosting
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
# 로컬 스크립트(sync:wiki)에서만 사용. App Hosting은 런타임 서비스 계정을 쓰므로 비워 둡니다.
GOOGLE_APPLICATION_CREDENTIALS=
REQUIRE_APP_CHECK=false

# Firebase Web client
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# 앱인토스(정적 번들) 전용. 비우면 App Hosting URL을 씁니다.
# 웹 빌드에서는 사용되지 않습니다.
NEXT_PUBLIC_API_BASE_URL=

# GitHub App
GITHUB_APP_ID=
# PEM 전문을 한 줄로. 줄바꿈은 리터럴 \n 두 글자로 넣는다 (github/client.ts가 복원한다).
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPOSITORY=EtainClub/future-wiki
GITHUB_WEBHOOK_SECRET=
