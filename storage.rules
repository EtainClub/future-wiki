rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /sources/{allPaths=**} {
      allow read, write: if isAdmin();
    }
    match /raw/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
